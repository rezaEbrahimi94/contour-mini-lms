{
  "name": "contour-mini-lms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings 0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check app components features lib tests scripts proxy.ts instrumentation.ts next.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,storage-api,realtime,edge-runtime,supavisor,postgres-meta && supabase migration up",
    "db:stop": "supabase stop",
    "db:lint": "supabase db lint --fail-on warning && supabase db advisors --fail-on warn",
    "test:unit": "node --test \"features/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:auth-profiles": "node scripts/auth-profiles.ts",
    "test:upgrade": "node scripts/upgrade.ts",
    "test:recovery": "node scripts/recovery.ts",
    "test:load": "node scripts/load.ts",
    "isolated": "node scripts/isolated.ts",
    "contracts": "node scripts/contracts.ts",
    "contracts:check": "node scripts/contracts.ts --check",
    "db:types": "node scripts/db-types.ts",
    "db:types:check": "node scripts/db-types.ts --check",
    "check": "npm run contracts:check && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
